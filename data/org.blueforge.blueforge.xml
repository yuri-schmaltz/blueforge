<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-blueforge-project">
    <comment>Blueforge project file</comment>
    <sub-class-of type="application/zip"/>
    <glob pattern="*.ryp" weight="100"/>
  </mime-type>
  <mime-type type="application/x-blueforge-sketch">
    <comment>Blueforge sketch file</comment>
    <glob pattern="*.rfs" weight="100"/>
  </mime-type>
  <mime-type type="application/x-ruida">
    <comment>Ruida laser cutter file</comment>
    <glob pattern="*.rd"/>
  </mime-type>
</mime-info>
